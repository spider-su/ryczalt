{
  "expo": {
    "name": "Ryczałt",
    "slug": "ryczalt",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/app-icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "pl.ryczalt.rental"
    },
    "android": {
      "package": "pl.ryczalt.rental",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#C52632"
      }
    },
    "web": {
      "favicon": "./public/favicon.png",
      "name": "Ryczałt",
      "shortName": "Ryczałt",
      "lang": "pl",
      "themeColor": "#C52632",
      "backgroundColor": "#F4F6F9",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      "expo-system-ui",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "expo-font",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "90116624-70fc-4f49-92f7-e787344dc969"
      }
    },
    "owner": "smart-box"
  }
}
